   "cell_type": "markdown",
   "id": "d6b72f9c",
   "metadata": {},
   "source": [
    "# Assembly of Primitive hierarchies (representing molecular structures) from MuPT core components from the ground up\n",
    "Here we see how to assemble a non-trivial molecular structure, with correct topology AND reasonable positions, using pure MuPT representation components\n",
    "The demonstration here is for a polyphenylene-sulfone middle repeat unit fragment, but it should become clear that the approaches for other systems vary little   \n",
    "\n",
    "This is definitely **not** intended or recommended as a tutorial for assembling repeat units for large, complex systems; if that's all you need, just use e.g. primitive_from_smiles()  \n",
    "Rather, this demo is intended to illustrate how all the components of the MuPT representation fit together and how information is organized w/in the representational hierarchy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "3b4e5e26",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "from scipy.spatial.transform import Rotation, RigidTransform\n",
    "\n",
    "from mupt.chemistry.core import ELEMENTS, BondType\n",
    "from mupt.geometry.shapes import PointCloud\n",
    "from mupt.builders.heading import TraversalDirection\n",
    "from mupt.mupr.primitives import Primitive, PrimitiveHandle, visualize_topology\n",
    "from mupt.mupr.connection import Connector, ConnectorHandle, AttachmentPoint"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "b5371769",
   "metadata": {},
   "outputs": [],
   "source": [
    "# common values references throughout construction\n",
    "traversal_pair : tuple[TraversalDirection, TraversalDirection] = (TraversalDirection.ANTERO, TraversalDirection.RETRO)\n",
    "\n",
    "center_pos = np.array([0, 0, 0], dtype=float)\n",
    "axis_pos   = np.array([1, 0, 0], dtype=float)\n",
    "corner_pos = np.array([1, 1, 1], dtype=float)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dcb5ab52",
   "metadata": {},
   "source": [
    "## Avenue 2) hierarchical assembly from chemically-meaningful subunits\n",
    "More involved conceptually, but reuses information as much as possible and illustrates the flexibility of the representation"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7a92d1d2",
   "metadata": {},
   "source": [
    "## Define p-phenyl group"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "4cdae4a7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# define connector types which feature in a phenyl ring\n",
    "arene_ring_conn = Connector(\n",
    "    anchor=AttachmentPoint({'c'}, position=center_pos),\n",
    "    linker=AttachmentPoint({'c'}, position=axis_pos),\n",
    "    bondtype=BondType.AROMATIC,\n",
    "    label='arene_ring_bond',\n",
    ")\n",
    "arene_substituent_master_conn = Connector(\n",
    "    anchor=AttachmentPoint({'c'}, position=center_pos),\n",
    "    linker=AttachmentPoint({'H', 'S', 'O', '*'}, position=axis_pos),\n",
    "    bondtype=BondType.SINGLE,\n",
    "    label='arene_substituent_bond',\n",
    ")\n",
    "arene_substituent_conns : dict[tuple[str, str], Connector] = arene_substituent_master_conn.individualize()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "fdb86975",
   "metadata": {},
   "outputs": [],
   "source": [
    "# define arene carbon\n",
    "arene_carbon = Primitive(\n",
    "    shape=PointCloud(center_pos),\n",
    "    element=ELEMENTS[6],\n",
    "    label='aryl_carbon'\n",
    ")\n",
    "c_subst_handle  : ConnectorHandle = arene_carbon.register_connector(arene_substituent_master_conn.copy())\n",
    "cc_ring_handle1 : ConnectorHandle = arene_carbon.register_connector(arene_ring_conn.copy())\n",
    "cc_ring_handle2 : ConnectorHandle = arene_carbon.register_connector(arene_ring_conn.copy())\n",
    "\n",
    "## move Connectors into triangular planar config around center\n",
    "for conn, rot in zip(arene_carbon.connectors.values(), Rotation.create_group('C3'), strict=True):\n",
    "    conn.rigidly_transform(RigidTransform.from_rotation(rot))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "c911ea51",
   "metadata": {},
   "outputs": [],
   "source": [
    "# define arene hydrogen\n",
    "Hc_conn : Connector = arene_carbon.connectors[c_subst_handle].counterpart()\n",
    "Hc_conn.anchor.attachables = {'H'} # specialize anchor attachment designation to hydrogen-only\n",
    "\n",
    "arene_hydrogen = Primitive(\n",
    "    shape=PointCloud(Hc_conn.anchor.position),\n",
    "    element=ELEMENTS[1],\n",
    "    label='aryl_hydrogen'\n",
    ")\n",
    "H_subst_handle : ConnectorHandle = arene_hydrogen.register_connector(Hc_conn)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "0c1fa64d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# define c-H unit appearing along arene ring\n",
    "arene_CH = Primitive(label='arene_CH')\n",
    "c_handle : PrimitiveHandle = arene_CH.attach_child(arene_carbon)\n",
    "H_handle : PrimitiveHandle = arene_CH.attach_child(arene_hydrogen)\n",
    "arene_CH.connect_children(\n",
    "    c_handle, c_subst_handle,\n",
    "    H_handle, H_subst_handle,\n",
    ")\n",
    "visualize_topology(arene_CH)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "997da09a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# assemble phenyl ring\n",
    "from itertools import cycle\n",
    "from mupt.mutils.iteration import sliding_window\n",
    "\n",
    "\n",
    "paraphenyl = Primitive(label='paraphenyl')\n",
    "ring_members : tuple[Primitive] = (\n",
    "    arene_carbon.copy(),\n",
    "    arene_CH.copy(),\n",
    "    arene_CH.copy(),\n",
    "    arene_carbon.copy(),\n",
    "    arene_CH.copy(),\n",
    "    arene_CH.copy(),\n",
    ")\n",
    "# place children along hexagon vertices on circumcircle of given size\n",
    "radius : float = 1.1\n",
    "for ring_member_prim, rot in zip(ring_members, Rotation.create_group('C6')):\n",
    "    transform = RigidTransform.from_rotation(rot) * RigidTransform.from_translation([radius, 0, 0])\n",
    "    ring_member_prim.rigidly_transform(transform)\n",
    "    ring_member_handle : PrimitiveHandle = paraphenyl.attach_child(ring_member_prim)\n",
    "    \n",
    "# adjust bond lengths and connect carbons along ring\n",
    "aligner_ballistic = ConnectorAntialignmentBallistic()\n",
    "for c1_handle, c2_handle in sliding_window(cycle(paraphenyl.children_by_handle), n=2):\n",
    "    if paraphenyl.internal_connection_between(c1_handle, c2_handle):\n",
    "        break # exit once wrapped all the way around ring\n",
    "    \n",
    "    paraphenyl.connect_children(\n",
    "        c1_handle, cc_ring_handle1,\n",
    "        c2_handle, cc_ring_handle2,\n",
    "    )\n",
    "    aligner_ballistic.mutually_antialign(\n",
    "        paraphenyl.fetch_connector_on_child(c1_handle, cc_ring_handle1),\n",
    "        paraphenyl.fetch_connector_on_child(c2_handle, cc_ring_handle2),\n",
    "    )"
   ]
  },
