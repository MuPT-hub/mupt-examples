    "frag_dir.mkdir(exist_ok=True)\n",
    "frag_path = frag_dir / frag_name\n",
    "\n",
    "mol = primitive_to_rdkit(unitprim)\n",
    "display(mol)\n",
    "MolToMolFile(mol, str(frag_path))"
