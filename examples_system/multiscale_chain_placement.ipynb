    "}\n",
    "end_groups : dict[TerminalGroup, str] = {\n",
    "    TerminalGroup.HEAD : 'head_bisphenol_A',\n",
    "    TerminalGroup.TAIL : 'tail_bisphenol_A',\n",
    "}"
